erDiagram
    USERS ||--o{ REACTIONS : performs
    USERS ||--o{ BOOKMARKS : saves
    USERS ||--o{ READING_HISTORY : logs
    NEWS ||--o{ REACTIONS : receives
    NEWS ||--o{ BOOKMARKS : contains
    NEWS ||--o{ READING_HISTORY : records

    USERS {
        ObjectId _id PK
        string email UK
        string password
        string role
        string name
        array categories
        datetime created_at
    }

    NEWS {
        ObjectId _id PK
        string title
        string content
        string category
        string author
        datetime published_at
        string url UK
        string image_url
        array embedding_384d
        int likes_count
        int reads_count
    }

    REACTIONS {
        ObjectId _id PK
        string user_id FK
        string news_id FK
        string type
        datetime created_at
    }

    BOOKMARKS {
        ObjectId _id PK
        string user_id FK
        string news_id FK
        datetime created_at
    }

    READING_HISTORY {
        ObjectId _id PK
        string user_id FK
        string news_id FK
        float duration_seconds
        datetime timestamp
    }
