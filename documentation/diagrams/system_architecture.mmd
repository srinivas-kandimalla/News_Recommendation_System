graph TB
    subgraph Client ["React 18 SPA Client (Port 5173)"]
        UI["React Router Views & MUI Components"]
        Auth["AuthContext (JWT in localStorage)"]
        Axios["Axios HTTP Client"]
    end

    subgraph Backend ["Flask REST API Service (Port 5000)"]
        Guard["JWT Guard (@token_required / @admin_required)"]
        Routes["11 Blueprints (user, news, recommendation, etc.)"]
        RecService["Recommendation Service"]
        NeuralRanker["PyTorch Neural Ranker (1159-d MLP)"]
        Scheduler["APScheduler Background Ingestion"]
    end

    subgraph Database ["Database & Storage"]
        MongoDB[("MongoDB 7.0 (news_recommendation_db)")]
        PyTorchWeights["Model Weights (neural_ranker.pt)"]
        Embedder["SentenceTransformer (all-MiniLM-L6-v2)"]
    end

    UI --> Auth
    Auth --> Axios
    Axios -->|HTTP REST with Bearer Token| Guard
    Guard --> Routes
    Routes --> RecService
    RecService --> NeuralRanker
    RecService --> Embedder
    RecService --> MongoDB
    NeuralRanker --> PyTorchWeights
    Scheduler -->|Every 30 Mins| MongoDB
